# ==============================================================================
# dsh-notebook — .gitignore
#
# Rule of thumb: everything generated by a tool is ignored; everything a user
# needs to build, run or review the plugin is committed. Two of those are easy
# to break by accident: `screenshots.json` is the repo-root screenshot manifest
# the plugin registry convention expects next to package.json, and
# `docs/images/**` is what both READMEs and that manifest point at. Never add a
# blanket `*.png` / `*.json` rule here.
# ==============================================================================

# --- dependencies -------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-cache/
.yarn/
jspm_packages/
bower_components/

# --- build output -------------------------------------------------------------
# `pnpm build` emits lib/**; consumers install it via the `prepare` script, so
# the artifact itself stays out of git. `pnpm pack` tarballs are also ignored.
lib/
dist/
build/
out/
.tsdown/
*.tsbuildinfo
*.tgz
*.tar.gz

# --- test & coverage output ---------------------------------------------------
coverage/
.nyc_output/
.vitest/
test-results/
*.lcov

# --- tooling caches -----------------------------------------------------------
.cache/
.turbo/
.eslintcache
.stylelintcache
.nx/

# --- logs ---------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- environment & secrets ----------------------------------------------------
# Never commit credentials. `.env.example` is the documented exception.
.env
.env.*
!.env.example

# --- local DSH runtime state --------------------------------------------------
# Only appears if you point DSH_HOME at the checkout while developing. Real
# user data lives in $DSH_HOME (default ~/.dsh), never in this repo.
.dsh/
storages/

# --- editors & OS -------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*.sublime-workspace
*~
\#*\#
.\#*

# --- agent / design scratch ---------------------------------------------------
# Internal briefs and registry recon notes. Kept out of the repo so the
# published tree contains only product files.
.briefs/
.recon/
.dsh-upgrade-backup/
